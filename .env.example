# QuantumTrade Environment Variables

# App Configuration
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# Database Configuration (Supabase Cloud)
DATABASE_URL=postgresql://<USER>:<PASSWORD>@jstuvjquxrciaazrsedx.supabase.co:5432/postgres

# Supabase API (Use new API keys from Project API keys section, not legacy keys)
# Note: The 'anon key' is labeled as the 'public' key in the Supabase dashboard
# Note: The 'service_role key' is the secret key with full access (same as SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_URL=https://jstuvjquxrciaazrsedx.supabase.co
SUPABASE_ANON_KEY=<your_anon_key>  # This is the 'public' key in the dashboard
SUPABASE_SERVICE_ROLE_KEY=<your_service_role_key>  # This is the secret key with full access

# Optional (Auth) (Get from Supabase Project API keys section)
SUPABASE_JWT_SECRET=<your_supabase_jwt_secret>

# Local Postgres Mirror
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quantumtrade_local

# Supabase Sync
SUPABASE_WEBHOOK_SECRET=<random_generated_secret>
SUPABASE_PROJECT_REF=jstuvjquxrciaazrsedx
SUPABASE_SYNC_INTERVAL=15  # minutes

# Backtesting
MOCK_DATA_COUNT=5000
MOCK_DATA_SEED=42

# API Keys (Replace with your actual keys)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
POLYGON_API_KEY=your_polygon_api_key
FINNHUB_API_KEY=your_finnhub_api_key

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://jstuvjquxrciaazrsedx.supabase.co
VITE_SUPABASE_ANON_KEY=<your_anon_key>  # Use the anon key (labeled as 'public' key in dashboard)

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DELTA=3600

# Redis Configuration (for caching/queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_AI_TRADING=true
ENABLE_MARKET_MAKING=false
ENABLE_RISK_MANAGEMENT=true