# QuantumTrade Environment Variables

# App Configuration
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quantumtrade
DB_USER=quantumtrade
DB_PASSWORD=quantumtrade
DB_URL=postgresql://quantumtrade:quantumtrade@localhost:5432/quantumtrade

# API Keys (Replace with your actual keys)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
POLYGON_API_KEY=your_polygon_api_key
FINNHUB_API_KEY=your_finnhub_api_key

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DELTA=3600

# Redis Configuration (for caching/queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_AI_TRADING=true
ENABLE_MARKET_MAKING=false
ENABLE_RISK_MANAGEMENT=true