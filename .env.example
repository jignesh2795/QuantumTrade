# Trading Configuration
TRADING_MODE=paper
EXCHANGE=binance
DEFAULT_SYMBOL=BTCUSDT
TIMEFRAME=1h

# Capital & Risk
INITIAL_CAPITAL=10000
MAX_POSITION_SIZE=0.1
MAX_DAILY_LOSS=0.02

# Strategy Parameters
STRATEGY=sma_crossover
SMA_FAST_PERIOD=10
SMA_SLOW_PERIOD=30

# API Keys (for live trading in Phase 2)
API_KEY=
API_SECRET=

# Database
DATABASE_URL=sqlite:///database/quantumtrade.db

# Logging
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000